<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Heatmap Kehadiran — {{ month_label }}</title>
<style>
  :root{ --bg:#0A0A0A; --surface:#141414; --surface2:#1F1F1F; --border:#262626;
    --text:#fff; --dim:#A3A3A3; --muted:#737373; }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,Arial,sans-serif}
  .wrap{max-width:1180px;margin:0 auto;padding:22px}
  h1{font-size:22px;margin:0}
  .subt{color:var(--dim);font-size:12px;margin-bottom:4px}
  .sticky{position:sticky;top:0;z-index:30;background:var(--bg);padding:14px 0 10px;border-bottom:1px solid var(--border)}
  .toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
  .search{flex:1;min-width:220px;display:flex;align-items:center;gap:8px;background:var(--surface2);
    border:1px solid var(--border);border-radius:8px;padding:8px 12px}
  .search input{flex:1;background:transparent;border:0;color:var(--text);font-size:14px;outline:none}
  .navbtn{background:var(--surface2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:7px 12px;cursor:pointer;font-size:14px;text-decoration:none}
  .navbtn:hover{background:#2a2a2a}
  .month{font-weight:700;font-size:15px;min-width:110px;text-align:center}
  .legend{display:flex;flex-wrap:wrap;gap:10px;font-size:11px;color:var(--dim)}
  .legend .it{display:flex;align-items:center;gap:5px}
  .sw{width:15px;height:15px;border-radius:4px;border:1px solid var(--border);display:inline-flex;
    align-items:center;justify-content:center;font-size:8px;font-weight:700}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:12px;
    padding:14px 16px;margin-bottom:12px;display:flex;gap:20px;align-items:flex-start}
  .card.hide{display:none}
  .who{min-width:150px}.who .nm{font-weight:700;font-size:15px}.who .dp{color:var(--muted);font-size:11px;margin-top:2px}
  table.grid{border-collapse:separate;border-spacing:4px}
  table.grid th{color:var(--muted);font-size:11px;font-weight:700;padding:0 0 2px}
  table.grid td.wd{color:var(--dim);font-size:11px;font-weight:700;padding-right:4px;text-align:right}
  .cell{width:46px;height:34px;border-radius:5px;font-size:11px;font-weight:700;
    display:flex;align-items:flex-start;justify-content:flex-start;padding:3px 0 0 5px;cursor:default}
  .cell.empty{background:transparent}
  .summary{margin-left:auto;display:grid;grid-template-columns:auto auto;gap:4px 16px;font-size:12px;color:var(--dim);min-width:180px}
  .summary .hd{grid-column:1/3;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:2px}
  .summary .row{display:flex;align-items:center;gap:7px}.summary .dot{width:12px;height:12px;border-radius:3px;border:1px solid var(--border)}
  .summary .ct{color:#fff;font-weight:700}
  #tip{position:fixed;z-index:50;pointer-events:none;background:#000;border:1px solid var(--border);
    border-radius:8px;padding:8px 10px;font-size:12px;line-height:1.5;display:none;max-width:240px;box-shadow:0 6px 20px rgba(0,0,0,.6)}
  #tip .k{color:var(--muted)}
  .empty{padding:60px;text-align:center;color:var(--dim);font-size:15px}
  .note{color:var(--muted);font-size:11px;margin-top:10px}
</style>
</head>
<body>
<div class="wrap">
  <h1>Heatmap Kehadiran</h1>
  <div class="subt">Hover/klik sel untuk detail. Hari kerja efektif {{ month_label }}: {{ eff_hari_kerja }} hari.</div>
  <div class="sticky">
    <div class="toolbar">
      <div class="search">🔍 <input id="q" placeholder="Cari / sortir nama karyawan…" oninput="filt()"/></div>
      <a class="navbtn" href="?month={{ prev_month }}">‹</a>
      <div class="month">{{ month_label }}</div>
      <a class="navbtn" href="?month={{ next_month }}">›</a>
    </div>
    <div class="legend">
      {% for l in legend %}<div class="it"><span class="sw" style="background:{{ l.color }};color:{{ l.text_color }}">{{ l.code }}</span>{{ l.label }}</div>{% endfor %}
    </div>
  </div>
  {% if is_empty %}
  <div class="empty">Belum ada data untuk bulan ini — import data fingerprint dulu.</div>
  {% else %}
  <div id="list">
  {% for e in employees %}
    <div class="card" data-name="{{ (e.nama ~ ' ' ~ e.dept)|lower }}">
      <div class="who"><div class="nm">{{ e.nama }}</div><div class="dp">{{ e.dept }}</div></div>
      <table class="grid">
        <thead><tr><th></th>{% for w in range(weeks|length) %}<th>M{{ w + 1 }}</th>{% endfor %}</tr></thead>
        <tbody>
        {% for wd in range(7) %}
          <tr><td class="wd">{{ weekday_labels[wd] }}</td>
          {% for w in range(weeks|length) %}
            {% set day = weeks[w][wd] %}
            {% if day == 0 %}<td><div class="cell empty"></div></td>
            {% else %}{% set c = e.cells[day] %}
            <td><div class="cell" style="background:{{ c.color }};color:{{ c.text_color }}"
                 data-lab="{{ c.label }}" data-tgl="{{ day }} {{ month_label }}"
                 data-masuk="{{ c.masuk }}" data-keluar="{{ c.keluar }}" data-telat="{{ c.telat }}" data-alasan="{{ c.alasan }}"
                 onmousemove="hov(event,this)" onmouseleave="hideTip()" onclick="clik(this)">{{ day }}</div></td>
            {% endif %}
          {% endfor %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <div class="summary"><div class="hd">Ringkasan — HK {{ e.hk }}</div>
        {% for m in summary_meta %}<div class="row"><span class="dot" style="background:{{ m.color }}"></span>{{ m.code }}: <span class="ct">{{ e.summary[m.code] }}</span></div>{% endfor %}
      </div>
    </div>
  {% endfor %}
  </div>
  <div class="note">HK = jumlah hari kerja yang dihadiri (Hadir, Terlambat, Dinas, Lupa absen). Sel abu-abu = belum ada data.</div>
  {% endif %}
</div>
<div id="tip"></div>
<script>
const tip=document.getElementById("tip");
function hov(e,el){const d=el.dataset;
  tip.innerHTML=`<b>${d.lab}</b><br><span class="k">Tanggal</span> ${d.tgl}<br>`+
    `<span class="k">Masuk</span> ${d.masuk} &nbsp; <span class="k">Keluar</span> ${d.keluar}<br>`+
    `<span class="k">Telat</span> ${d.telat}<br><span class="k">Alasan</span> ${d.alasan}`;
  tip.style.display="block";let x=e.clientX+14,y=e.clientY+14;if(x+250>innerWidth)x=e.clientX-254;
  tip.style.left=x+"px";tip.style.top=y+"px";}
function hideTip(){tip.style.display="none";}
function clik(el){const d=el.dataset;alert(`${d.lab}\nTanggal: ${d.tgl}\nMasuk: ${d.masuk} | Keluar: ${d.keluar}\nTelat: ${d.telat}\nAlasan: ${d.alasan}`);}
function filt(){const v=document.getElementById("q").value.toLowerCase();
  document.querySelectorAll(".card").forEach(c=>c.classList.toggle("hide",v&&!c.dataset.name.includes(v)));}
</script>
</body>
</html>
