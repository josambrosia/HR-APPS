<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<title>HR Dashboard · {{ period_label }}</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  @page{size:A4;margin:0}
  body{font-family:'Segoe UI','Inter',sans-serif;background:#fff;color:#171717;font-size:11px;line-height:1.45;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .doc{padding:14mm}

  /* Header */
  .b-head{display:flex;justify-content:space-between;align-items:flex-end;padding-bottom:16px;border-bottom:2px solid #ec4899;margin-bottom:22px;position:relative}
  .b-head::after{content:"";position:absolute;left:0;bottom:-5px;width:60px;height:8px;background:#22d3ee}
  .b-head .badge{display:inline-block;background:#ec4899;color:#fff;font-size:9px;font-weight:700;padding:3px 10px;border-radius:3px;letter-spacing:1.5px;margin-bottom:8px}
  .b-head h1{font-size:26px;font-weight:700;color:#171717;letter-spacing:-.5px}
  .b-head .meta{text-align:right;font-family:Consolas,monospace;font-size:10px;color:#737373}
  .b-head .meta .lg{color:#22d3ee;font-size:14px;font-weight:700;letter-spacing:.5px;margin-bottom:2px;font-family:'Segoe UI'}

  /* KPI strip */
  .b-kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
  .b-kpi .k{background:#fafafa;border:1px solid #e5e5e5;padding:14px 16px;border-radius:6px;position:relative;overflow:hidden}
  .b-kpi .k::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:#ec4899}
  .b-kpi .k.cyan::before{background:#22d3ee}
  .b-kpi .k.violet::before{background:#a855f7}
  .b-kpi .k.emerald::before{background:#10b981}
  .b-kpi .k.amber::before{background:#f97316}
  .b-kpi .k .l{font-size:9.5px;color:#737373;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;font-weight:600}
  .b-kpi .k .n{font-family:Consolas,monospace;font-size:28px;color:#171717;font-weight:700;line-height:1}
  .b-kpi .k .n .u{font-size:14px;color:#737373;font-weight:500;margin-left:3px}
  .b-kpi .k .delta{font-size:10px;color:#525252;margin-top:4px}
  .b-kpi .k .delta.delta-good{color:#10b981}
  .b-kpi .k .delta.delta-bad{color:#dc2626}
  .b-kpi .k .delta.delta-neutral{color:#737373}

  /* Sections */
  .b-section{margin-bottom:22px;break-inside:avoid}
  .b-section h2{font-size:11px;color:#171717;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid #e5e5e5;font-weight:700}
  .b-section h2::before{content:"// ";color:#ec4899}
  .b-twocol{display:grid;grid-template-columns:1fr 1fr;gap:18px}

  /* Tables */
  .b-table{width:100%;border-collapse:collapse;font-size:11px}
  .b-table thead{display:table-header-group}
  .b-table tr{break-inside:avoid;page-break-inside:avoid}
  .b-table th{text-align:left;font-size:9.5px;color:#737373;text-transform:uppercase;letter-spacing:.8px;padding:7px 6px;background:#fafafa;border-bottom:1px solid #ec4899}
  .b-table td{padding:6px 6px;border-bottom:1px solid #f5f5f5}
  .b-table .num{font-family:Consolas,monospace;text-align:right;color:#171717;font-weight:600}
  .b-table .cyan{color:#22d3ee;font-size:10px;text-transform:uppercase;letter-spacing:.5px}
  .b-table .rank{font-family:Consolas,monospace;color:#737373;width:30px}

  /* Pills */
  .b-pill{display:inline-block;background:#fff7ed;color:#ea580c;padding:3px 8px;border-radius:10px;font-size:10px;font-weight:600;margin:2px}
  .b-pill.violet{background:#f5f3ff;color:#7c3aed}
  .b-pill.emerald{background:#ecfdf5;color:#059669}

  /* Pola Jam Masuk */
  .b-jam{background:#fafafa;border-radius:8px;padding:14px 16px}
  .b-jam .jh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .b-jam .jh .total{font-family:Consolas;font-size:10px;color:#737373}
  .b-bar-row{display:grid;grid-template-columns:100px 1fr 50px;gap:10px;align-items:center;font-size:10.5px;padding:3px 0}
  .b-bar-row .lbl{font-family:Consolas;color:#525252;font-size:10px}
  .b-bar-row .lbl.early,.b-bar-row .lbl.ontime{color:#10b981}
  .b-bar-row .lbl.mild{color:#d97706}
  .b-bar-row .lbl.mod{color:#ea580c}
  .b-bar-row .lbl.severe,.b-bar-row .lbl.chronic{color:#dc2626}
  .b-bar-track{height:14px;background:#fff;border:1px solid #e5e5e5;border-radius:7px;overflow:hidden}
  .b-bar-fill{height:100%;border-radius:7px;display:flex;align-items:center;padding:0 8px;color:#fff;font-size:9.5px;font-weight:600;white-space:nowrap;overflow:hidden}
  .b-bar-fill.early,.b-bar-fill.ontime{background:linear-gradient(90deg,#10b981,#34d399)}
  .b-bar-fill.mild{background:linear-gradient(90deg,#f59e0b,#fbbf24);color:#171717}
  .b-bar-fill.mod{background:linear-gradient(90deg,#f97316,#fb923c)}
  .b-bar-fill.severe{background:linear-gradient(90deg,#ef4444,#f87171)}
  .b-bar-fill.chronic{background:linear-gradient(90deg,#b91c1c,#dc2626)}
  .b-bar-row .v{font-family:Consolas;font-weight:700;text-align:right;color:#171717}
  .b-jam-divider{border-top:1px dashed #e5e5e5;margin:8px 0;text-align:center;font-size:9px;color:#a3a3a3;text-transform:uppercase;letter-spacing:1px;padding-top:6px}

  /* Footer — lives inside <tfoot>. Browsers natively repeat table-footer-group
     content at the bottom of every printed page when content paginates, which
     is the reliable cross-browser print-footer pattern. position:fixed in
     @media print was unreliable in Chrome — content vanished entirely on
     multi-page PDFs. */
  .print-footer{padding:10px 14mm;border-top:1px solid #e5e5e5;display:flex;justify-content:space-between;align-items:flex-end;font-size:9.5px;color:#737373;font-family:Consolas,monospace;background:#fff}
  .print-footer .brand{text-align:right;line-height:1.35}
  .print-footer .brand svg{height:26px;width:auto;display:block}
  .print-footer .brand .sub{font-size:8px;color:#525252;letter-spacing:.5px;font-family:'Segoe UI',sans-serif}

  /* Page-layout table — wraps content in <tbody>, footer in <tfoot> for per-page repeat. */
  .page-table{width:100%;border-collapse:collapse}
  .page-table > tbody > tr > td,
  .page-table > tfoot > tr > td{padding:0}
  .page-table tfoot{display:table-footer-group}

  /* Page 2 header */
  .b-rank-head{padding-bottom:8px;border-bottom:2px solid #ec4899;margin-bottom:10px;position:relative}
  .b-rank-head::after{content:"";position:absolute;left:0;bottom:-5px;width:40px;height:8px;background:#22d3ee}
  .b-rank-head h2{font-size:18px;color:#171717}
  .b-rank-head .sub{font-size:10px;color:#737373;text-transform:uppercase;letter-spacing:1.5px;margin-top:6px;font-family:Consolas}

  /* Sign-off */
  .b-signoff{margin-top:16px;display:flex;justify-content:flex-end;break-inside:avoid;page-break-inside:avoid}
  .b-signoff .so{text-align:center;font-size:10px;min-width:200px}
  .b-signoff .so .role{color:#525252}
  .b-signoff .so .gap{height:46px}
  .b-signoff .so .name{font-weight:700;color:#171717;border-top:1px solid #171717;padding-top:4px}

  /* Print */
  .page-break{break-before:page;page-break-before:always}
  .empty-state{padding:14px;background:#fafafa;border:1px dashed #e5e5e5;border-radius:6px;text-align:center;color:#737373;font-size:11px}

  /* Outlier transparency line (4e) */
  .outlier-note{font-size:10px;color:#7c3aed;background:#f5f3ff;border-left:3px solid #a855f7;padding:6px 10px;margin-bottom:10px;border-radius:0 4px 4px 0}

  /* Screen-only print reminder (hidden on paper) — keeps the browser's
     file:// path & timestamp out of the "confidential" PDF. */
  .print-hint{max-width:180mm;margin:8px auto 0;padding:8px 12px;background:#fef9c3;border:1px solid #fde047;border-radius:6px;font-size:11px;color:#713f12;font-family:'Segoe UI',sans-serif}
  @media print{.print-hint{display:none}}
</style>
</head>
<body>

<div class="print-hint">Sebelum simpan PDF: di dialog cetak browser, buka <b>More settings / Setelan lainnya</b> lalu matikan <b>&ldquo;Headers and footers&rdquo;</b> supaya URL &amp; tanggal tidak ikut tercetak.</div>

<table class="page-table">
<tbody><tr><td>

<div class="doc">
  {# === HEADER === #}
  <div class="b-head">
    <div>
      <div class="badge">{{ period_badge_text }}</div>
      <h1>HR Absensi Dashboard <span style="color:#a3a3a3;font-weight:500"> · </span> <span style="color:#22d3ee">{{ period_label }}</span></h1>
      <div style="font-size:11px;color:#737373;margin-top:4px">{{ ranking|length }} karyawan</div>
    </div>
    <div class="meta">
      <div>{{ period_start }} — {{ period_end }}</div>
      <div>Gen: {{ generated_at }}</div>
    </div>
  </div>

  {# === KPI === #}
  {% if sections.kpi %}
  <div class="b-kpi">
    <div class="k"><div class="l">Total Terlambat</div><div class="n">{{ kpi.total_terlambat }}</div><div class="delta delta-{{ kpi_deltas.total_terlambat.color_class }}">{% if kpi_deltas.total_terlambat.delta is none %}—{% else %}{{ kpi_deltas.total_terlambat.arrow }} {{ kpi_deltas.total_terlambat.delta|abs }} dari {{ kpi_deltas.total_terlambat.period_word }}{% endif %}</div></div>
    <div class="k cyan"><div class="l">Rata-rata / Kejadian</div><div class="n">{{ '%.0f' % kpi.avg_min }}<span class="u">min</span></div><div class="delta delta-{{ kpi_deltas.avg_min.color_class }}">{% if kpi_deltas.avg_min.delta is none %}—{% else %}{{ kpi_deltas.avg_min.arrow }} {{ kpi_deltas.avg_min.delta|abs }} min dari {{ kpi_deltas.avg_min.period_word }}{% endif %}</div></div>
    <div class="k amber"><div class="l">Coaching</div><div class="n">{{ kpi.coaching_count }}</div><div class="delta delta-{{ kpi_deltas.coaching.color_class }}">{% if kpi_deltas.coaching.delta is none %}—{% else %}{{ kpi_deltas.coaching.arrow }} {{ kpi_deltas.coaching.delta|abs }} dari {{ kpi_deltas.coaching.period_word }}{% endif %}</div></div>
    <div class="k emerald"><div class="l">Teladan</div><div class="n">{{ kpi.teladan_count }}</div><div class="delta delta-{{ kpi_deltas.teladan.color_class }}">{% if kpi_deltas.teladan.delta is none %}—{% else %}{{ kpi_deltas.teladan.arrow }} {{ kpi_deltas.teladan.delta|abs }} dari {{ kpi_deltas.teladan.period_word }}{% endif %}</div></div>
  </div>
  {% endif %}

  {# === TOP 5 === #}
  {% if sections.top5_late %}
  <div class="b-section">
    <h2>Top 5 Paling Terlambat</h2>
    {% if top5_late %}
    <table class="b-table">
      <thead><tr><th>#</th><th>Nama</th><th>Dept</th><th style="text-align:right">Menit</th><th style="text-align:right">Kejadian</th></tr></thead>
      <tbody>
        {% for r in top5_late %}
        <tr><td class="rank">{{ '%02d' % loop.index }}</td><td>{{ r.nama }}</td><td class="cyan">{{ r.dept }}</td><td class="num">{{ r.total_terlambat }}</td><td class="num">{{ r.hari_telat }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="empty-state">Tidak ada keterlambatan di periode ini.</div>{% endif %}
  </div>
  {% endif %}

  {# === TELADAN + COACHING === #}
  <div class="b-twocol">
    {% if sections.top5_teladan %}
    <div class="b-section">
      <h2>Karyawan Teladan</h2>
      {% if teladan %}
        {% for r in teladan %}<span class="b-pill emerald">{{ r.nama }} &middot; {{ r.dept }}</span>{% endfor %}
        <div style="font-size:10px;color:#737373;margin-top:8px">Hadir penuh tanpa terlambat</div>
      {% else %}<div class="empty-state">Belum ada teladan periode ini.</div>{% endif %}
    </div>
    {% endif %}

    {% if sections.coaching %}
    <div class="b-section">
      <h2>Butuh Coaching</h2>
      {% if coaching %}
        {% for r in coaching %}<span class="b-pill">{{ r.nama }} &middot; {{ r.total_terlambat }}m</span>{% endfor %}
      {% else %}<div class="empty-state">Tidak ada kandidat coaching.</div>{% endif %}
      <div style="font-size:10px;color:#737373;margin-top:8px">{% if coaching_working_days > 0 %}Threshold &ge; {{ coaching_threshold_effective }} mnt ({{ coaching_threshold_daily }} mnt/hari &times; {{ coaching_working_days }} hari kerja){% else %}Belum ada data hari kerja periode ini.{% endif %}</div>
    </div>
    {% endif %}
  </div>

  {# === POLA JAM MASUK === #}
  {% if sections.pola_jam_masuk %}
  <div class="b-section">
    <h2>Pola Jam Masuk</h2>
    {% set jam_total = jam_masuk|sum(attribute='count') %}
    {% set jam_max_list = jam_masuk|map(attribute='count')|list %}
    {% set jam_max = jam_max_list|max if jam_max_list else 0 %}
    <div class="b-jam">
      <div class="jh">
        <div style="font-weight:600;color:#171717;font-size:11px">Distribusi waktu kedatangan &middot; {{ jam_total }} sesi present</div>
        <div class="total">absen tidak termasuk</div>
      </div>
      {% if jam_total == 0 %}<div class="empty-state">Tidak ada data jam masuk.</div>{% else %}
        {% for b in jam_masuk %}
          {% if b.band == '08:00' %}<div class="b-jam-divider">— ambang tepat waktu —</div>{% endif %}
          <div class="b-bar-row">
            <span class="lbl {{ b.severity }}">{{ b.band }}</span>
            <div class="b-bar-track"><div class="b-bar-fill {{ b.severity }}" style="width:{% if jam_max > 0 %}{{ (b.count * 100 / jam_max)|round(0)|int }}{% else %}0{% endif %}%"></div></div>
            <span class="v">{{ b.count }}</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# === PAGE BREAK === #}
  <div class="page-break"></div>

  {# === RANKING LENGKAP (mandatory) === #}
  <div class="b-rank-head">
    <h2>Ranking Lengkap &middot; {{ ranking|length }} Karyawan</h2>
    <div class="sub">// {{ period_label }} &middot; sort by total menit terlambat</div>
  </div>
  {% if outlier_count > 0 %}
  <div class="outlier-note">
    {{ outlier_count }} karyawan dikecualikan dari analisa: {{ outlier_names }}
  </div>
  {% endif %}
  {% if ranking %}
  <table class="b-table">
    <thead><tr><th>#</th><th>Nama</th><th>Dept</th><th style="text-align:right">Menit</th><th style="text-align:right">Kejadian</th><th style="text-align:right">Tidak Hadir</th></tr></thead>
    <tbody>
      {% for r in ranking %}
        {% set is_teladan = r.total_terlambat == 0 and r.hari_telat == 0 and r.absent_count == 0 %}
        <tr {% if is_teladan %}style="background:#f0fdf4"{% endif %}>
          <td class="rank">{{ '%02d' % loop.index }}</td>
          <td {% if is_teladan %}style="color:#10b981;font-weight:700"{% endif %}>{{ r.nama }}</td>
          <td class="cyan">{{ r.dept }}</td>
          <td class="num" {% if is_teladan %}style="color:#10b981"{% endif %}>{{ r.total_terlambat }}</td>
          <td class="num" {% if is_teladan %}style="color:#10b981"{% endif %}>{{ r.hari_telat }}</td>
          <td class="num" {% if r.absent_count >= 1 and not is_teladan %}style="color:#dc2626"{% elif is_teladan %}style="color:#10b981"{% endif %}>{{ r.absent_count }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <div style="font-size:10px;color:#737373;margin-top:8px">Highlight emerald = karyawan teladan &middot; Angka merah pada kolom absen = perlu perhatian khusus (&ge;1 hari tidak hadir).</div>
  {% else %}<div class="empty-state">Tidak ada data karyawan di periode ini.</div>{% endif %}

  {# === SIGN-OFF === #}
  <div class="b-signoff">
    <div class="so">
      <div class="role">HR Officer in Charge</div>
      <div class="gap"></div>
      <div class="name">{{ hr_officer_name }}</div>
    </div>
  </div>

</div>

</td></tr></tbody>
<tfoot><tr><td>

<div class="print-footer">
  <span>// confidential</span>
  <div class="brand">{{ brand_lockup_svg | safe }}<span class="sub">Tech Solution</span></div>
</div>

</td></tr></tfoot>
</table>

</body>
</html>
