<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<title>Editorial Report — {{ period_label }}</title>
<style>
  /* ── RESET & BASE ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:        #1A1209;
    --ink-dim:    #5A4A38;
    --ink-faint:  #9C8E80;
    --paper:      #F5EFE6;
    --rule:       #C8B89A;
    --red:        #B23A1A;
    --green:      #2D5F3F;
    --accent-bg:  #EDE3D6;
  }

  body {
    font-family: "Georgia", "Times New Roman", serif;
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.7;
    padding: 0;
    margin: 0;
  }

  .page {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 56px;
    background: var(--paper);
  }

  /* ── MASTHEAD ── */
  .masthead {
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 10px 0;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .masthead-title {
    font-family: "Georgia", serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--ink);
  }

  .masthead-meta {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 1.2px;
    color: var(--ink-dim);
    text-transform: uppercase;
  }

  .masthead-sub {
    border-bottom: 3px double var(--ink);
    padding-bottom: 12px;
    margin-bottom: 28px;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 2px;
    color: var(--ink-dim);
    text-transform: uppercase;
    text-align: center;
  }

  /* ── PRINT TIP ── */
  .print-tip {
    background: var(--accent-bg);
    border-left: 3px solid var(--red);
    padding: 8px 12px;
    margin-bottom: 20px;
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: var(--ink-dim);
  }

  /* ── SECTION DIVIDER ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 32px 0 18px;
  }

  .section-divider hr {
    flex: 1;
    border: none;
    border-top: 1px solid var(--rule);
  }

  .section-label {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9.5px;
    font-variant: small-caps;
    letter-spacing: 2.5px;
    color: var(--ink-dim);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── 2-COLUMN LAYOUT ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 0;
  }

  /* ── LEAD PARAGRAPH with Drop Cap ── */
  .lead-text {
    font-family: "Georgia", serif;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink);
    margin-bottom: 16px;
  }

  .lead-text::first-letter {
    float: left;
    font-family: "Georgia", serif;
    font-size: 60px;
    line-height: 0.78;
    margin: 6px 8px 0 0;
    font-weight: 700;
    color: var(--red);
  }

  /* ── KPI CALLOUTS ── */
  .kpi-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .kpi-item {
    border-top: 1px solid var(--rule);
    padding-top: 10px;
  }

  .kpi-label {
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 2px;
  }

  .kpi-number {
    font-family: "Georgia", serif;
    font-size: 38px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -1px;
  }

  .kpi-number.red   { color: var(--red); }
  .kpi-number.dark  { color: var(--ink); }
  .kpi-number.green { color: var(--green); }

  .kpi-unit {
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: var(--ink-dim);
    margin-top: 2px;
  }

  /* ── TABLES ── */
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12.5px;
    margin-top: 6px;
  }

  thead tr { border-bottom: 2px solid var(--ink); }

  thead th {
    font-variant: small-caps;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--ink-dim);
    padding: 6px 8px;
    text-align: left;
    font-weight: 400;
  }

  thead th.num { text-align: right; }

  tbody tr { border-bottom: 1px solid var(--rule); }
  tbody tr:last-child { border-bottom: 2px solid var(--ink); }

  tbody td {
    padding: 7px 8px;
    color: var(--ink);
    vertical-align: middle;
  }

  tbody td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-family: "Georgia", serif;
  }

  tbody td.rank {
    font-family: "Georgia", serif;
    font-weight: 700;
    width: 24px;
    text-align: center;
  }

  tbody td.name { font-weight: 600; color: var(--ink); }
  tbody td.dept { font-style: italic; color: var(--ink-dim); font-size: 11.5px; }

  .red-text   { color: var(--red); }
  .green-text { color: var(--green); }

  /* ── TELADAN NOTE ── */
  .teladan-note {
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: var(--ink-dim);
    font-style: italic;
    margin-top: 8px;
    border-left: 2px solid var(--green);
    padding-left: 8px;
  }

  /* ── COACHING SECTION ── */
  .coaching-item {
    border-top: 1px solid var(--rule);
    padding: 10px 0;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 10px;
    align-items: start;
  }

  .coaching-item:last-child { border-bottom: 1px solid var(--rule); }

  .coaching-dagger {
    font-size: 14px;
    color: var(--red);
    font-family: "Georgia", serif;
    margin-top: 2px;
  }

  .coaching-name {
    font-weight: 600;
    font-size: 13px;
    font-family: Arial, sans-serif;
  }

  .coaching-dept {
    font-size: 11px;
    font-style: italic;
    color: var(--ink-dim);
    margin-top: 1px;
    font-family: Arial, sans-serif;
  }

  .coaching-stats { text-align: right; font-family: "Georgia", serif; font-size: 13px; }
  .coaching-mins  { font-weight: 700; color: var(--red); }
  .coaching-days  { font-size: 10px; color: var(--ink-dim); font-family: Arial, sans-serif; margin-top: 2px; }

  .empty-state {
    font-family: Arial, sans-serif;
    font-size: 12px;
    color: var(--ink-faint);
    font-style: italic;
    padding: 12px 0;
  }

  /* ── RANKING TABLE ── */
  .ranking-section { margin-top: 8px; }

  .alert-flag {
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 0.8px;
    padding: 1px 5px;
    background: var(--red);
    color: white;
    border-radius: 2px;
  }

  .clean-flag {
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 0.8px;
    padding: 1px 5px;
    background: var(--green);
    color: white;
    border-radius: 2px;
  }

  /* ── FOOTER ── */
  .footer {
    margin-top: 40px;
    border-top: 3px double var(--ink);
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-variant: small-caps;
    letter-spacing: 1px;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  /* ── PRINT ── */
  @media print {
    body { background: var(--paper); }
    .page { padding: 20mm 22mm; max-width: none; }
    .print-tip { display: none; }
    .two-col { page-break-inside: avoid; }
    .section-divider { page-break-after: avoid; }
    table { page-break-inside: auto; }
    thead { display: table-header-group; }
    tbody tr { page-break-inside: avoid; }
    @page { margin: 15mm; size: A4; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- MASTHEAD -->
  <div class="masthead">
    <div class="masthead-title">HR Intelligence</div>
    <div class="masthead-meta">{{ period_label }} &middot; Internal Report</div>
  </div>
  <div class="masthead-sub">Laporan Kinerja Kehadiran &amp; Disiplin Karyawan &mdash; Periode {{ period_label }}</div>

  <div class="print-tip">
    &#128161; <strong>Tip:</strong> Aktifkan <em>"Background graphics"</em> di opsi Print untuk hasil PDF terbaik.
  </div>

  <!-- TWO-COLUMN: LEAD + KPI SIDEBAR -->
  <div class="two-col">

    <div>
      <div class="section-divider">
        <hr><span class="section-label">&#167; Executive Summary</span><hr>
      </div>

      <p class="lead-text">
        Pada periode {{ period_label }}, data kehadiran mencatat akumulasi keterlambatan sebesar
        {{ kpi.total_terlambat }} menit di seluruh departemen, dengan {{ kpi.total_absen }} kejadian
        absensi tanpa keterangan. Sebanyak {{ kpi.coaching_count }} karyawan direkomendasikan
        masuk sesi coaching intensif berdasarkan ambang batas keterlambatan.
      </p>

      <p style="font-size:13px; color:var(--ink-dim); font-family:Arial,sans-serif; line-height:1.65;">
        &#9658; Laporan ini diterbitkan otomatis oleh sistem HR pada {{ generated_at }}.
      </p>
    </div>

    {% if sections.kpi %}
    <div class="kpi-column">
      <div class="section-divider">
        <hr><span class="section-label">&#167; Key Figures</span><hr>
      </div>

      <div class="kpi-item">
        <div class="kpi-label">Total Keterlambatan</div>
        <div class="kpi-number red">{{ kpi.total_terlambat }}</div>
        <div class="kpi-unit">menit &bull; {{ period_label }}</div>
      </div>

      <div class="kpi-item">
        <div class="kpi-label">Absen Tanpa Izin</div>
        <div class="kpi-number dark">{{ kpi.total_absen }}</div>
        <div class="kpi-unit">hari kehadiran</div>
      </div>

      <div class="kpi-item">
        <div class="kpi-label">Dipanggil Coaching</div>
        <div class="kpi-number red">{{ kpi.coaching_count }}</div>
        <div class="kpi-unit">karyawan</div>
      </div>
    </div>
    {% endif %}

  </div><!-- /two-col -->

  <!-- TOP 5 LATE + TELADAN side by side -->
  {% if sections.top5_late or sections.top5_teladan %}
  <div class="two-col">

    {% if sections.top5_late %}
    <div>
      <div class="section-divider">
        <hr><span class="section-label">&#167; Top 5 Keterlambatan</span><hr>
      </div>
      {% if top5_late %}
      <table>
        <thead>
          <tr>
            <th style="width:28px">&sect;</th>
            <th>Nama</th>
            <th>Dept.</th>
            <th class="num">Menit</th>
          </tr>
        </thead>
        <tbody>
          {% for r in top5_late %}
          <tr>
            <td class="rank {% if loop.index == 1 %}red-text{% endif %}">{{ loop.index }}</td>
            <td class="name {% if loop.index == 1 %}red-text{% endif %}">{{ r.nama }}</td>
            <td class="dept">{{ r.dept or '-' }}</td>
            <td class="num {% if loop.index == 1 %}red-text{% endif %}">{{ r.total_terlambat }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="empty-state">Tidak ada keterlambatan periode ini.</div>
      {% endif %}
    </div>
    {% endif %}

    {% if sections.top5_teladan %}
    <div>
      <div class="section-divider">
        <hr><span class="section-label">&#167; Top 5 Teladan</span><hr>
      </div>
      {% if top5_teladan %}
      <table>
        <thead>
          <tr>
            <th style="width:28px">&sect;</th>
            <th>Nama</th>
            <th>Dept.</th>
            <th class="num">Skor</th>
          </tr>
        </thead>
        <tbody>
          {% for r in top5_teladan %}
          <tr>
            <td class="rank {% if loop.index <= 2 %}green-text{% endif %}">{{ loop.index }}</td>
            <td class="name {% if loop.index <= 2 %}green-text{% endif %}">{{ r.nama }}</td>
            <td class="dept">{{ r.dept or '-' }}</td>
            <td class="num {% if loop.index <= 2 %}green-text{% endif %}">{{ r.score }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="teladan-note">
        &#9671; Skor = total menit terlambat bulan berjalan. Nol berarti nol keterlambatan tercatat.
      </div>
      {% else %}
      <div class="empty-state">Belum ada data teladan.</div>
      {% endif %}
    </div>
    {% endif %}

  </div><!-- /two-col top 5 -->
  {% endif %}

  <!-- COACHING -->
  {% if sections.coaching %}
  <div class="section-divider">
    <hr><span class="section-label">&#167; Coaching &amp; Pembinaan</span><hr>
  </div>
  {% if coaching %}
    {% for r in coaching %}
    <div class="coaching-item">
      <div class="coaching-dagger">&dagger;</div>
      <div>
        <div class="coaching-name">{{ r.nama }}</div>
        <div class="coaching-dept">{{ r.dept or '-' }}</div>
      </div>
      <div class="coaching-stats">
        <div class="coaching-mins">{{ r.total_terlambat }} mnt</div>
        <div class="coaching-days">{{ r.hari_telat }} hari telat</div>
      </div>
    </div>
    {% endfor %}
  {% else %}
    <div class="empty-state">Tidak ada karyawan yang perlu coaching periode ini.</div>
  {% endif %}
  {% endif %}

  <!-- RANKING DEPARTEMEN -->
  {% if sections.departemen %}
  <div class="section-divider">
    <hr><span class="section-label">&#167; Ranking Departemen</span><hr>
  </div>
  {% if ranking_departemen %}
  <table>
    <thead>
      <tr>
        <th>Departemen</th>
        <th class="num">Pegawai</th>
        <th class="num">Terlambat (mnt)</th>
      </tr>
    </thead>
    <tbody>
      {% for r in ranking_departemen %}
      <tr>
        <td class="name">{{ r.dept }}</td>
        <td class="num">{{ r.pegawai_count }}</td>
        <td class="num {% if r.total_terlambat > 0 %}red-text{% endif %}">{{ r.total_terlambat }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty-state">Belum ada data departemen.</div>
  {% endif %}
  {% endif %}

  <!-- HARI PALING RAWAN -->
  {% if sections.hari_rawan %}
  <div class="section-divider">
    <hr><span class="section-label">&#167; Hari Paling Rawan</span><hr>
  </div>
  {% if hari_paling_rawan %}
  <table>
    <thead>
      <tr>
        <th>Hari</th>
        <th class="num">Hari Telat</th>
        <th class="num">Total Hari</th>
      </tr>
    </thead>
    <tbody>
      {% for r in hari_paling_rawan %}
      <tr>
        <td class="name">{{ r.hari }}</td>
        <td class="num">{{ r.terlambat_count }}</td>
        <td class="num">{{ r.total_rows }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty-state">Belum ada data harian.</div>
  {% endif %}
  {% endif %}

  <!-- FULL RANKING -->
  {% if sections.ranking %}
  <div class="section-divider">
    <hr><span class="section-label">&#167; Ranking Lengkap Karyawan</span><hr>
  </div>

  <div class="ranking-section">
    {% if ranking %}
    <table>
      <thead>
        <tr>
          <th style="width:28px">&sect;</th>
          <th>Nama</th>
          <th>Departemen</th>
          <th class="num">Terlambat (mnt)</th>
          <th class="num">Hari Telat</th>
          <th class="num">Tdk Hadir</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for r in ranking %}
        <tr>
          <td class="rank {% if loop.index == 1 %}red-text{% endif %}">{{ loop.index }}</td>
          <td class="name {% if r.total_terlambat == 0 %}green-text{% elif loop.index <= 3 %}red-text{% endif %}">{{ r.nama }}</td>
          <td class="dept">{{ r.dept or '-' }}</td>
          <td class="num {% if r.total_terlambat == 0 %}green-text{% elif loop.index <= 3 %}red-text{% endif %}">{{ r.total_terlambat }}</td>
          <td class="num">{{ r.hari_telat }}</td>
          <td class="num">{{ r.tidak_hadir }}</td>
          <td>
            {% if r.total_terlambat >= coaching_threshold %}<span class="alert-flag">Alert</span>
            {% elif r.total_terlambat == 0 %}<span class="clean-flag">Baik</span>
            {% else %}<span style="color:var(--ink-dim); font-size:11px;">&#9671; Cukup</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty-state">Belum ada data ranking.</div>
    {% endif %}
  </div>
  {% endif %}

  <!-- FOOTER -->
  <div class="footer">
    <span>&#169; HR Intelligence &bull; Internal &mdash; Not for Distribution</span>
    <span>Digenerate: {{ generated_at }}</span>
    <span>{{ period_label }} &bull; Page 1 of 1</span>
  </div>

</div><!-- /page -->
</body>
</html>
