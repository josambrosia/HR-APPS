# ============================================================
# HR Absensi App — .gitignore
# ============================================================

# ---- Sensitive data (PII pegawai) ----
Data Absensi/
data/*.db
data/*.db-journal
data/*.bak
output/

# ---- Brainstorm session (local-only artifacts) ----
.superpowers/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl
MANIFEST

# PyInstaller
*.spec
*.manifest

# pytest / testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Logs & temp ----
*.log
*.tmp
~$*.xlsx
~$*.xls

# ---- Generated reports ----
*[filled].xlsx
hr-dashboard-*.html
